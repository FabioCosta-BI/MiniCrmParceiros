# Copie este arquivo como .env e preencha somente no servidor.
BQ_PROJECT_ID=
BQ_DATASET=
BQ_CARTEIRA_TABELA=crm_carteira_diaria
GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\seguro\service-account.json

# PostgreSQL da TI: atendimentos e controle de tentativas.
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SCHEMA=starlink_crm

# Limites da carteira nacional por dia.
LIMITE_CAMPEOES_DIA=6
LIMITE_CIDADES_ESTRATEGICAS_DIA=25

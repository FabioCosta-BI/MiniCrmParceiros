# Copie este arquivo como .env e preencha somente no servidor.
# Fonte Pegasus B2B: cadastro/cobertura via PostgreSQL e vendas via ODBC.
PEGASUS_PG_HOST=
PEGASUS_PG_PORT=5432
PEGASUS_PG_DATABASE=
PEGASUS_PG_USER=
PEGASUS_PG_PASSWORD=
PEGASUS_ODBC_DSN=Pegasus b2b

# Referências locais mantidas no servidor (não entram no Git).
RANKING_ANATEL_PATH=data/Ranking de Cidades - Starlink.xlsx

# Banco PostgreSQL da TI: carteira, atendimentos e controle de tentativas.
CRM_PG_HOST=
CRM_PG_PORT=5432
CRM_PG_DATABASE=
CRM_PG_USER=
CRM_PG_PASSWORD=
CRM_PG_SCHEMA=starlink_crm

# Somente desenvolvimento local: usa o CSV de teste sem gravar interações no banco.
# CRM_MODO_TESTE_CSV=1

# Limites por bloco de UFs.
LIMITE_CAMPEOES_GRUPO=6
LIMITE_CIDADES_ESTRATEGICAS_GRUPO=24
LIMITE_ANIVERSARIOS_GRUPO=5
